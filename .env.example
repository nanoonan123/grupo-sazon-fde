# Copy this file to .env for local development. Do not commit real credentials.
APP_NAME="Grupo Sazon Candidate Screening API"
APP_VERSION="0.1.0"
APP_ENVIRONMENT="development"
AMBIGUITY_RETRY_LIMIT=2
SERVICE_AREAS_PATH="data/service_areas.json"
DATABASE_URL="sqlite+aiosqlite:///./data/grupo_sazon.db"

# LLM-backed conversation calls require a real key. API startup does not.
OPENAI_API_KEY=
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_TIMEOUT_SECONDS=8

# ElevenLabs browser widget and authenticated webhook tool; intentionally blank.
ELEVENLABS_AGENT_ID=
ELEVENLABS_TOOL_SECRET=
